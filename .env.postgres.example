# 复制为 .env.postgres，供 Compose 中的 postgres 服务初始化数据库。
POSTGRES_USER=student_app
# 使用 python -c "import secrets; print(secrets.token_hex(24))" 生成并替换。
# .env.api 的 DATABASE_URL 必须使用同一账号、密码和数据库名。
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_DB=student_tasks

# 这些变量用于空数据目录的首次初始化。
# 修改本文件不会自动修改已有数据库角色的密码或重命名数据库。
