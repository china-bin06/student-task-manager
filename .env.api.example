# 复制为 .env.api，仅供 Compose 中的 api 服务使用。
# 将数据库密码占位符替换为 .env.postgres 中同一密码。
# 建议使用 secrets.token_hex() 生成十六进制密码，避免 URL 特殊字符转义问题。
APP_NAME="学生任务管理系统"
DATABASE_URL=postgresql+psycopg://student_app:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/student_tasks

# 使用 python -c "import secrets; print(secrets.token_hex(32))" 生成并替换。
# 不要将真实密钥提交到 Git。没有默认密钥，长度至少为 64 个字符。
JWT_SECRET_KEY=REPLACE_WITH_64_CHARACTER_RANDOM_HEX_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
