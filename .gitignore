# Python 环境与缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# 本地配置与密钥
.env
.env.*

# 配置模板可以提交
!.env.example
!.env.*.example

# SQLite 数据及辅助文件
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# 测试报告与运行日志
.coverage
.coverage.*
htmlcov/
*.log

# 前端依赖、构建产物与本地备份
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.legacy-backup/

# # 本地临时学习、验证脚本，第一版先保留
# /check_*.py
# /backfill_task_owner.py

# Word 临时文件
~$*

# 线上数据库备份与证书私钥
backups/
*.dump
*.sql
*.sql.gz
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
